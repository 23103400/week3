console.log("Numbers from 1 to 10:");

for (let i = 1; i <= 10; i++) {
    console.log(i);
}

console.log("Even numbers:");

for (let i = 1; i <= 20; i++) {
    if (i % 2 === 0) {
        console.log(i);
    }
}

console.log("Odd numbers:");

for (let i = 1; i <= 20; i++) {
    if (i % 2 !== 0) {
        console.log(i);
    }
}

let tableNumber = 5;

console.log("Multiplication Table of", tableNumber);

for (let i = 1; i <= 10; i++) {
    console.log(tableNumber + " x " + i + " = " + (tableNumber * i));
}

let sum = 0;

for (let i = 1; i <= 10; i++) {
    sum += i;
}

console.log("Sum from 1 to 10:", sum);

console.log("While loop:");

let number = 1;

while (number <= 5) {
    console.log(number);
    number++;
}

console.log("Do-While loop:");

let count = 1;

do {
    console.log(count);
    count++;
} while (count <= 5);

console.log("Numbers in reverse:");

for (let i = 10; i >= 1; i--) {
    console.log(i);
}

console.log("Countdown:");

let countdown = 5;

while (countdown >= 1) {
    console.log(countdown);
    countdown--;
}
