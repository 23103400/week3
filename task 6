let year = 2024;

if (year % 400 === 0 || (year % 4 === 0 && year % 100 !== 0)) {
    console.log(year + " is a leap year.");
} else {
    console.log(year + " is not a leap year.");
}


let number = 5;
let factorial = 1;

for (let i = 1; i <= number; i++) {
    factorial *= i;
}

console.log("Factorial:", factorial);


let sum = 0;

for (let i = 1; i <= 20; i++) {
    if (i % 2 === 0) {
        sum += i;
    }
}

console.log("Sum of even numbers:", sum);


